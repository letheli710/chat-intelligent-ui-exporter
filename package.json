{
  "name": "chat-intelligent-ui-exporter",
  "version": "0.11.40",
  "description": "本项目开发适配 ChatGPT 新界面的 Chrome 导出插件，重点保存对话中有价值的讨论及上下文。用户选择消息或内容片段后，导出 Markdown 与本地资产包；正文保留为可检索文字，普通图片与 SVG 优先保存原始资产，其他可视化和少见的自生成工具用截图保存当前画面。",
  "scripts": {
    "test": "node --test --test-force-exit tests/*.test.cjs",
    "package": "node scripts/package.cjs",
    "pdf-check": "node scripts/pdf-check.cjs",
    "panel-check": "node scripts/panel-check.cjs"
  },
  "keywords": [],
  "author": "letheli710",
  "license": "MIT",
  "repository": "github:letheli710/chat-intelligent-ui-exporter",
  "type": "commonjs",
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "jsdom": "^26.1.0",
    "lucide-static": "1.48.0",
    "markdown-it": "^14.3.3",
    "marked": "^15.0.12",
    "pdfjs-dist": "^6.4.299",
    "puppeteer-core": "^25.14.0"
  },
  "private": true
}
